#!/usr/bin/env python
"""Standalone reconstruction tool with explicit method parameters."""
import argparse,json
from pathlib import Path
import numpy as np
from inpainting import dct_inpaint,validate_observations


def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--method',choices=['dct'],required=True)
    p.add_argument('--input',type=Path,required=True)
    p.add_argument('--out',type=Path,required=True)
    p.add_argument('--k',type=int,required=True)
    p.add_argument('--iterations',type=int,required=True)
    a=p.parse_args()
    with np.load(a.input,allow_pickle=False) as z:y,m=validate_observations(z['observations'],z['mask'])
    if y.shape!=(32,32):raise ValueError('input must have shape [32,32]')
    for name in ['reconstruction.npz','run.json']:
        if (a.out/name).exists():raise FileExistsError('Use a new output directory')
    x=dct_inpaint(y,m,a.k,a.iterations)
    a.out.mkdir(parents=True,exist_ok=True)
    np.savez_compressed(a.out/'reconstruction.npz',reconstruction=x)
    metadata=dict(method=a.method,input=str(a.input),n=32,k=a.k,iterations=a.iterations)
    (a.out/'run.json').write_text(json.dumps(metadata,indent=2)+'\n')
    err=float(np.max(np.abs(x[m]-y[m]))) if m.any() else 0.
    print(f'observed_max_error\tmissing_pixels\n{err:.9g}\t{int((~m).sum())}')


if __name__=='__main__':main()
